<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>44efe0f1-faea-4bc8-85d8-7210b3627d30</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <!--
    Contact-form SMTP credentials for the published (IIS/web.config) environment.
    These MSBuild properties default to empty and are passed in at publish time
    via `/p:SmtpHost=... /p:SmtpPassword=...` from CI secrets — never hardcode
    real values here. Locally, use `dotnet user-secrets` or
    appsettings.Development.json instead; this ItemGroup only affects the
    generated web.config used by IIS deployments.
  -->
  <ItemGroup>
    <EnvironmentVariables Include="Smtp__Host">
      <Value>$(SmtpHost)</Value>
    </EnvironmentVariables>
    <EnvironmentVariables Include="Smtp__Port">
      <Value>$(SmtpPort)</Value>
    </EnvironmentVariables>
    <EnvironmentVariables Include="Smtp__User">
      <Value>$(SmtpUser)</Value>
    </EnvironmentVariables>
    <EnvironmentVariables Include="Smtp__Password">
      <Value>$(SmtpPassword)</Value>
    </EnvironmentVariables>
    <EnvironmentVariables Include="Smtp__From">
      <Value>$(SmtpFrom)</Value>
    </EnvironmentVariables>
    <EnvironmentVariables Include="Contact__ToEmail">
      <Value>$(ContactToEmail)</Value>
    </EnvironmentVariables>
  </ItemGroup>

</Project>
