<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>44efe0f1-faea-4bc8-85d8-7210b3627d30</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IAmFara.Web.Tests" />
  </ItemGroup>

  <!--
    DB-IP Country Lite (download.db-ip.com) — CC BY 4.0, attribution required
    (see the report email footer). Not embedded in the assembly (it's ~8MB);
    copied alongside the published app instead and read from disk by
    GeoIpService. Refresh process: see docs/analytics.md.
  -->
  <ItemGroup>
    <None Include="GeoIP\dbip-country-lite.mmdb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaxMind.Db" Version="3.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
  </ItemGroup>

  <!--
    Contact-form config (other than the Resend API key, see below) is
    injected into the published web.config via the SDK's own
    $(WebConfigEnvironmentVariables) property — a single "Name=Value%3BName2=
    Value2" string (";" must be escaped as %3B, since a literal one is parsed
    as an MSBuild list separator). It's passed in at publish time by CI
    (see the deploy workflows) — never hardcode real values here. Locally,
    use `dotnet user-secrets` or appsettings.Development.json instead.

    The Resend API key itself is NOT here — it's set directly as an App
    Pool environment variable ("Email_ApiKey") in the SmarterASP.NET
    control panel instead, so it survives independently of what CI deploys.
  -->

</Project>
