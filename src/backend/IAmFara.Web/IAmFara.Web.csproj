<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>44efe0f1-faea-4bc8-85d8-7210b3627d30</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <!--
    Contact-form config for the published (IIS/web.config) environment.
    These MSBuild properties default to empty and are passed in at publish
    time via `/p:ResendFromEmail=...` etc. from CI secrets — never hardcode
    real values here. Locally, use `dotnet user-secrets` or
    appsettings.Development.json instead; this ItemGroup only affects the
    generated web.config used by IIS deployments.

    The Resend API key itself is NOT here — it's set directly as an App
    Pool environment variable ("Email_ApiKey") in the SmarterASP.NET
    control panel instead, so it survives independently of what CI deploys.
  -->
  <ItemGroup>
    <EnvironmentVariables Include="Resend__FromEmail">
      <Value>$(ResendFromEmail)</Value>
    </EnvironmentVariables>
    <EnvironmentVariables Include="Contact__ToEmail">
      <Value>$(ContactToEmail)</Value>
    </EnvironmentVariables>
  </ItemGroup>

</Project>
