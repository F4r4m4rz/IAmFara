<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>44efe0f1-faea-4bc8-85d8-7210b3627d30</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <!--
    Contact-form email credentials (Resend API) for the published
    (IIS/web.config) environment. These MSBuild properties default to empty
    and are passed in at publish time via `/p:ResendApiKey=...` from CI
    secrets — never hardcode real values here. Locally, use
    `dotnet user-secrets` or appsettings.Development.json instead; this
    ItemGroup only affects the generated web.config used by IIS deployments.
  -->
  <ItemGroup>
    <EnvironmentVariables Include="Resend__ApiKey">
      <Value>$(ResendApiKey)</Value>
    </EnvironmentVariables>
    <EnvironmentVariables Include="Resend__FromEmail">
      <Value>$(ResendFromEmail)</Value>
    </EnvironmentVariables>
    <EnvironmentVariables Include="Contact__ToEmail">
      <Value>$(ContactToEmail)</Value>
    </EnvironmentVariables>
  </ItemGroup>

</Project>
