<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>44efe0f1-faea-4bc8-85d8-7210b3627d30</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <!--
    Contact-form config (other than the Resend API key, see below) is
    injected into the published web.config via the SDK's own
    $(WebConfigEnvironmentVariables) property — a single "Name=Value%3BName2=
    Value2" string (";" must be escaped as %3B, since a literal one is parsed
    as an MSBuild list separator). It's passed in at publish time by CI
    (see the deploy workflows) — never hardcode real values here. Locally,
    use `dotnet user-secrets` or appsettings.Development.json instead.

    The Resend API key itself is NOT here — it's set directly as an App
    Pool environment variable ("Email_ApiKey") in the SmarterASP.NET
    control panel instead, so it survives independently of what CI deploys.
  -->

</Project>
